{
    "name": "booru-lightbox",
    "private": true,
    "version": "3.7.10",
    "displayName": "Booru Lightbox",
    "author": "bakatrouble",
    "description": "Lightbox viewers on booru websites",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "postinstall": "wxt prepare",
        "sign": "tsx utils/signExtension.ts",
        "update-manifest": "tsx utils/updateManifest.ts",
        "test": "pnpm test:unit && pnpm test:e2e",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "lint": "biome check .",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/await-timeout": "^0.3.4",
        "@types/node": "^26.6.5",
        "@types/qs": "^6.15.1",
        "@types/shelljs": "^0.10.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "@wxt-dev/module-vue": "^1.0.3",
        "clipanion": "4.0.0-rc.4",
        "dotenv": "^18.0.9",
        "jsdom": "^30.1.3",
        "jwt-simple": "^0.5.6",
        "shelljs": "^0.10.0",
        "simple-git": "^4.0.2",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
        "vite": "^8.3.5",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.5",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.4",
        "yocto-spinner": "^1.2.2"
    },
    "dependencies": {
        "@mdi/js": "^7.4.47",
        "@vueuse/core": "^15.0.0",
        "@vueuse/gesture": "^2.0.0",
        "await-timeout": "^1.1.1",
        "ky": "^2.2.0",
        "mdi-vue": "^3.0.13",
        "portal-vue": "^3.0.0",
        "qs": "^6.16.1",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44"
    },
    "packageManager": "pnpm@8.5.1",
    "pnpm": {
        "overrides": {
            "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2"
        }
    }
}
